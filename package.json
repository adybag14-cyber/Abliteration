{
  "name": "abliteration-handbook",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive beginner guide and living technical handbook for LLM abliteration",
  "scripts": {
    "dev": "node scripts/prepare-handbook.mjs && vite",
    "handbook:prepare": "node scripts/prepare-handbook.mjs",
    "handbook:render": "tsx --tsconfig tsconfig.app.json scripts/prerender-handbook.tsx",
    "handbook:audit": "node scripts/audit-handbook.mjs",
    "test:handbook": "node --test scripts/test-handbook.mjs",
    "build": "node scripts/prepare-handbook.mjs && tsc -b && vite build && npm run handbook:render && node scripts/audit-handbook.mjs && node scripts/audit-site-artifact.mjs",
    "audit:site-artifact": "node scripts/audit-site-artifact.mjs --verify-only",
    "render:og-card": "node scripts/render-og-card.mjs",
    "preview": "vite preview",
    "test:site": "vitest run",
    "test:site:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report artifacts/playwright/report",
    "audit:live:puppeteer": "node scripts/puppeteer-live-audit.mjs",
    "audit:live:handbook": "node scripts/audit-handbook-live.mjs",
    "fetch:docs": "node scripts/fetch-docs.mjs",
    "fetch:docs:firefox": "node scripts/fetch-docs.mjs --firefox",
    "fetch:arxiv-qcri": "node scripts/fetch-research-papers.mjs",
    "fetch:research-papers": "node scripts/fetch-research-papers.mjs",
    "fetch:web-research": "node scripts/fetch-web-research.mjs",
    "fetch:web-research:firefox": "node scripts/fetch-web-research.mjs --firefox",
    "fetch:heretic": "node scripts/fetch-heretic-tools.mjs",
    "fetch:hf-models": "node scripts/fetch-hf-heretic-models.mjs",
    "fetch:hf-models:firefox": "node scripts/fetch-hf-heretic-models.mjs --firefox",
    "fetch:all": "node scripts/fetch-heretic-tools.mjs && node scripts/fetch-docs.mjs && node scripts/fetch-research-papers.mjs && node scripts/fetch-web-research.mjs --firefox && node scripts/fetch-hf-heretic-models.mjs --firefox && node scripts/build-heretic-models-doc.mjs",
    "build:heretic-models-doc": "node scripts/build-heretic-models-doc.mjs",
    "validate": "node scripts/ralph-validate.mjs",
    "ralph": "node scripts/ralph-loop.mjs",
    "ralph:ci": "node scripts/ralph-loop.mjs --skip-fetch --max 1",
    "ralph:next": "node scripts/ralph-next-task.mjs",
    "ralph:turn-end": "node scripts/ralph-turn-end.mjs",
    "ralph:autostart": "node scripts/ralph-autostart.mjs",
    "ralph:autostart:stop": "node scripts/ralph-autostart-stop.mjs",
    "eval:stats": "node scripts/count-eval-prompts.mjs",
    "eval:jarvis-safe": "python scripts/filter-jarvis-eval.py",
    "eval:cybergym": "python scripts/cybergym-eval-stub.py",
    "eval:compare": "python scripts/compare-abliteration-evals.py",
    "contrast:prepare": "python scripts/prepare-contrast-set.py",
    "experiment:manifest": "python scripts/experiment-manifest.py",
    "test:advanced-tools": "python scripts/test-advanced-tools.py",
    "eval:refusal": "python scripts/eval-refusal-rate.py",
    "abliterate:estimate": "python scripts/estimate-refusal-direction.py",
    "abliterate:apply": "python scripts/apply-weight-abliteration.py",
    "abliterate:hook": "python scripts/inference-hook-ablation.py",
    "abliterate:eval": "python scripts/eval-refusal-rate.py",
    "cxx:build": "node scripts/build-cxx.mjs",
    "cxx:test": "node scripts/run-cxx-tests.mjs",
    "cxx:sanitize": "node scripts/run-cxx-sanitizers.mjs",
    "cxx:self-check": "node scripts/run-cxx-self-check.mjs",
    "cxx:smoke": "node scripts/smoke-cxx-package.mjs",
    "ralph:continue:on": "node scripts/ralph-continue-on.mjs",
    "ralph:continue:off": "node scripts/ralph-continue-off.mjs",
    "ralph:continue:status": "node scripts/ralph-continue-status.mjs",
    "ralph:continue:watch": "node scripts/ralph-continue-watch.mjs",
    "ralph:seed": "node scripts/ralph-seed-backlog.mjs",
    "ralph:monitor": "node scripts/ralph-monitor.mjs",
    "ralph:regress": "node scripts/ralph-regress.mjs",
    "research:validate": "python scripts/validate-research-refresh.py",
    "research:fetch": "python scripts/refresh-research-catalog.py",
    "research:download": "python scripts/download-research-model.py",
    "research:run": "python scripts/run-research-experiment.py",
    "research:test": "python scripts/test-selective-tools.py",
    "research:package": "node scripts/package-research-tools.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "github-slugger": "^2.0.0",
    "jsdom": "^29.1.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "11.17.2",
    "playwright": "^1.60.0",
    "puppeteer": "^25.8.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.17",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.13",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
